      "content": "from slugify import slugify\nfrom slugify.__main__ import parse_args, slugify_params\n\ndef test_regex_forwarded_none():\n    params = slugify_params(parse_args(['slugify', 'Hello']))\n    assert params['regex_pattern'] is None\n    assert slugify(**params) == 'hello'\n\ndef test_regex_forwarded_custom():\n    pattern = r'[^a-z_]+'\n    params = slugify_params(parse_args(['slugify', 'Hello_42', '--regex-pattern', pattern]))\n    assert params['regex_pattern'] == pattern\n    assert slugify(**params) == 'hello_'\n\ndef test_other_options_preserved():\n    params = slugify_params(parse_args(['slugify', 'A B', '--separator', '_', '--no-lowercase']))\n    assert params['separator'] == '_'\n    assert params['lowercase'] is False\n    assert params['regex_pattern'] is None\n    assert slugify(**params) == 'A_B'\n\ndef test_iterable_options_still_work():\n    reps = iter([('|', 'or'), iter(['%', 'percent'])])\n    out = slugify('a|b%c', replacements=reps)\n    assert out == slugify('a|b%c', replacements=[('|', 'or'), ('%', 'percent')])\n    sw = iter(['the'])\n    out2 = slugify('the quick the', stopwords=sw)\n    assert out2 == slugify('the quick the', stopwords=['the'])\n    out3 = slugify('The Quick The', stopwords=['The'], lowercase=False)\n    assert out3 == 'quick'",
